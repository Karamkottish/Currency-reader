# Copy to .env for local use. Every value has a safe default; none is required.

# Address and port to listen on. 127.0.0.1 only accepts connections from this
# computer. Use 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=3000

# development | production | test
NODE_ENV=development

# Serve the interactive docs at /docs and the spec at /openapi.json.
# Defaults to true outside production.
SWAGGER_ENABLED=true

# Requests per minute per client address, for most endpoints and for /v1/ask.
RATE_LIMIT_PER_MINUTE=60
ASK_RATE_LIMIT_PER_MINUTE=10

# Comma-separated browser origins allowed to call the API. Empty = none.
# The mobile app does not need this; it is for web tools only.
CORS_ORIGINS=

# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
